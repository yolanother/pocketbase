# PocketBase Docker Environment Configuration
# Copy this file to .env and customize for your deployment

# ============================================================================
# Port Configuration
# ============================================================================
# The port on which PocketBase will be accessible on your host machine
PB_PORT=8090

# ============================================================================
# Volume Mount Paths
# ============================================================================
# IMPORTANT: Change these paths to match your NAS or server directory structure
# 
# Examples:
# - Synology: /volume1/docker/pocketbase/data
# - QNAP: /share/Container/pocketbase/data
# - UnRAID: /mnt/user/appdata/pocketbase/data
# - Linux: /opt/pocketbase/data or /srv/pocketbase/data

# Main data directory (database and uploaded files) - REQUIRED
PB_DATA_PATH=./pb_data

# Public files directory (optional)
PB_PUBLIC_PATH=./pb_public

# JavaScript hooks directory (optional)
PB_HOOKS_PATH=./pb_hooks

# Custom migrations directory (optional)
PB_MIGRATIONS_PATH=./pb_migrations

# ============================================================================
# Server Configuration
# ============================================================================
# HTTP server listen address
# 0.0.0.0 allows connections from any IP (required for external access)
PB_HTTP_ADDR=0.0.0.0:8090

# ============================================================================
# Security Configuration
# ============================================================================
# Encryption key for sensitive data fields (HIGHLY RECOMMENDED for production)
# Generate a secure random key: openssl rand -hex 32
# IMPORTANT: Keep this secret and back it up - you'll need it to decrypt data
PB_ENCRYPTION_ENV=

# ============================================================================
# System Configuration
# ============================================================================
# Timezone setting (see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=UTC

# ============================================================================
# Resource Limits (Optional)
# ============================================================================
# Uncomment and set these in docker-compose.yml to limit container resources
# PB_CPU_LIMIT=1.0
# PB_MEMORY_LIMIT=512M
# PB_CPU_RESERVATION=0.25
# PB_MEMORY_RESERVATION=128M
